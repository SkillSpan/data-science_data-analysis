{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile Completeness v1 Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "student_profile_id",
    "fields"
  ],
  "properties": {
    "student_profile_id": {
      "type": "integer",
      "minimum": 1
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "university_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "student_university_number": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "specialization": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "academic_level": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "career_status": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "availability": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "interests": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
